{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 8,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "max-length": 45,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "{:%A, %d de %B de %Y}"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5,
        "tooltip": false
    },

    "memory": {
        "format": "RAM {percentage}%",
        "interval": 5,
        "tooltip": false
    },

    "network": {
        "format-wifi": "WIFI {essid} {signalStrength}%",
        "format-ethernet": "ETH {ipaddr}",
        "format-disconnected": "NET OFF",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "MUTE",
        "tooltip": true
    },

    "battery": {
        "bat": "BAT0",
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "format-plugged": "BAT {capacity}% AC",
        "tooltip": true
    },

    "tray": {
        "spacing": 8
    }
}
